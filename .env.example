# Tameri Project - Environment Variables
# =======================================
# Copy this file to .env and update the values
#
# cp .env.example .env

# ===================
# Application
# ===================
NODE_ENV=development
PORT=3000

# ===================
# Zitadel (Authentication)
# ===================
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_EXTERNALDOMAIN=localhost
ZITADEL_EXTERNALPORT=8090
ZITADEL_EXTERNALSECURE=false
ZITADEL_ISSUER=http://localhost:8090

# Zitadel Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=zitadel

# ===================
# CouchDB (Database)
# ===================
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin
COUCHDB_PORT=5984
COUCHDB_URL=http://admin:admin@localhost:5984

# ===================
# MinIO (S3 Storage)
# ===================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=tameri-bucket

# S3 Compatible Config (for AWS SDK)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tameri-bucket
S3_REGION=us-east-1

# ===================
# Redis (Cache)
# ===================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
