# Tameri Project - Environment Variables
# =======================================
# Copy this file to .env and update the values
#
# cp .env.example .env
#
# Quick setup: make setup

# ===================
# COMPOSE
# ===================
COMPOSE_PROJECT_NAME=tameri-project

# ===================
# Application
# ===================
NODE_ENV=development
PORT=3000
APP_NAME=Tameri
API_DOMAIN=http://localhost:3000
WEBSITE_DOMAIN=http://localhost:4200

# ===================
# Demo Mode (Seeder)
# ===================
# Set to "true" to auto-seed demo data on startup
DEMO_MODE=false
# Default password for all demo users (admin@tameri.app, editor@tameri.app, etc.)
DEMO_USER_PASSWORD=Secret.1234

# ===================
# PostgreSQL (for SuperTokens)
# ===================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ===================
# SuperTokens (Authentication)
# ===================
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_PORT=3567

# ===================
# CouchDB (Document Database)
# ===================
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin
COUCHDB_PORT=5984
COUCHDB_URL=http://admin:admin@localhost:5984

# ===================
# MinIO (S3-Compatible Storage)
# ===================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=tameri-bucket

# S3 Compatible Config (for AWS SDK in app)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tameri-bucket
S3_REGION=us-east-1
# Public URL for accessing files (use CDN URL in production)
S3_PUBLIC_URL=http://localhost:9000

# ===================
# Redis (Cache)
# ===================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ===================
# imgproxy (Image Processing)
# ===================
IMGPROXY_PORT=8080
IMGPROXY_URL=http://localhost:8080
# Security keys (optional in dev, required in production)
# Generate with: echo $(xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
IMGPROXY_KEY=
IMGPROXY_SALT=

# ===================
# Zitadel (Future Auth - not yet active)
# ===================
# ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# ZITADEL_EXTERNALDOMAIN=localhost
# ZITADEL_EXTERNALPORT=8090
# ZITADEL_EXTERNALSECURE=false
# ZITADEL_ISSUER=http://localhost:8090

# ===================
# Logging
# ===================
LOG_LEVEL=debug

# ===================
# CORS (comma-separated origins)
# ===================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===================
# File Upload
# ===================
MAX_FILE_SIZE=52428800
# 50MB in bytes
