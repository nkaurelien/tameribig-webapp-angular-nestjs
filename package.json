{
  "name": "tameri-project",
  "private": true,
  "version": "0.1.0",
  "description": "Tameri - Monorepo with NestJS Backend and AngularJS Frontend",
  "author": "nkaurelien",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @tameri/backend build",
    "build:frontend": "pnpm --filter @tameri/frontend build",
    "dev": "pnpm --filter @tameri/backend start:dev",
    "dev:backend": "pnpm --filter @tameri/backend start:dev",
    "dev:frontend": "pnpm --filter @tameri/frontend dev",
    "start": "pnpm -r start",
    "start:backend": "pnpm --filter @tameri/backend start:prod",
    "start:frontend": "pnpm --filter @tameri/frontend start",
    "lint": "pnpm -r lint",
    "lint:backend": "pnpm --filter @tameri/backend lint",
    "lint:frontend": "pnpm --filter @tameri/frontend lint",
    "format": "pnpm -r format",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @tameri/backend test",
    "test:frontend": "pnpm --filter @tameri/frontend test",
    "test:cov": "pnpm --filter @tameri/backend test:cov",
    "test:e2e": "pnpm --filter @tameri/backend test:e2e",
    "seed": "pnpm --filter @tameri/backend seed",
    "docs": "npx docsify-cli serve docs --port 3333",
    "prepare": "husky"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core"
    ]
  }
}
